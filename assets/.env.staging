# Configurações APP
APP_NAME=ProDAQ
ENV=staging

# Configurações MQTT
MQTT_CLIENT_ID=prodaq_app
MQTT_HOST=staging-mqtt.intecnik.com.br
MQTT_PORT=8883
MQTT_SECURE=true
MQTT_HOST_WEB=wss://staging-mqtt.intecnik.com.br/mqtt
MQTT_PORT_WEB=8084


# PRODAQ API
PRODAQ_API_BASE_URL=https://staging-api.intecnik.com.br

# Tópicos MQTT
# Uma rota por versão de tópico, separadas por vírgula. Todas são assinadas
# e aceitas; a primeira é a primária, usada nos tópicos que o app mostra e
# gera. As quatro DEVICE_*_ROUTES seguem a mesma ordem entre si; DATA_ROUTES
# é independente delas (a request vai na versão em que o dispositivo foi
# ouvido), então dados e dispositivos podem migrar em momentos diferentes.
# Rotas de dados precisam de :companyId e :equipmentId; as de dispositivo, de
# :companyId e :mac. v2 separa equipamentos
# (equipments/:equipmentId) de dispositivos (devices/:mac); v1 fica como
# primária até o backend (ACLs do EMQX, itc_pd_mqtt_consumer) aceitar v2.
DATA_ROUTES="v1/prodaq/d2b/:companyId/:equipmentId,v2/prodaq/d2b/:companyId/equipments/:equipmentId"
LOGS_ROUTE=v1/prodaq/a2b/log/:mqttClientId
DEVICE_PRESENCE_ROUTES="v1/prodaq/d2b/:companyId/devices/:mac/presence,v2/prodaq/d2b/:companyId/devices/:mac/presence"
DEVICE_STATE_ROUTES="v1/prodaq/d2b/:companyId/devices/:mac/state,v2/prodaq/d2b/:companyId/devices/:mac/state"
DEVICE_REQUEST_ROUTES="v1/prodaq/b2d/:companyId/devices/:mac,v2/prodaq/b2d/:companyId/devices/:mac"
DEVICE_RESPONSE_ROUTES="v1/prodaq/d2b/:companyId/devices/:mac,v2/prodaq/d2b/:companyId/devices/:mac"

# Instalação de dispositivo (captive portal local)
DEVICE_IP=192.168.4.1
DEVICE_INSTALL_PORT=5050

# Timeouts (em milissegundos/segundos)
MQTT_TIMEOUT_MS=5000
DATASOURCE_TIMEOUT_SECONDS=2

# Configurações de Paginação
MAX_PAGINATION_LIMIT=100
DEFAULT_PAGE_SIZE=20

# Limites de Validação
MAX_EQUIPMENT_NAME_LENGTH=100
MAX_EQUIPMENT_TAG_LENGTH=30
MAX_EQUIPMENT_DESCRIPTION_LENGTH=500
MAX_MQTT_TOPIC_LENGTH=100
MIN_SEARCH_PATTERN_LENGTH=2

DEFAULT_COMPANY_NAME=ProDAQ
DEFAULT_COMPANY_ID=0
DEFAULT_COMPANY_DESCRIPTION="Process Data Aquisition"
DEFAULT_COMPANY_ADDRESS=
DEFAULT_COMPANY_PHONE=
DEFAULT_COMPANY_EMAIL=prodaq.intecnik@gmail.com
DEFAULT_COMPANY_WEBSITE=prodaq.intecnik.com.br
DEFAULT_COMPANY_IMAGE_URL=https://prodaq.intecnik.com.br/icons/Icon-512.png
DEFAULT_COMPANY_TOPIC="prodaq"